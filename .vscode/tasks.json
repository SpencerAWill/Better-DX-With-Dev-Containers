    {
      "label": "clean (notification-functions)",
      "command": "dotnet",
      "args": [
        "clean",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/apps/notification-functions"
      }
    },
    {
      "label": "build (notification-functions)",
      "command": "dotnet",
      "args": [
        "build",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "dependsOn": "clean (notification-functions)",
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/apps/notification-functions"
      }
    },
    {
      "label": "clean release (notification-functions)",
      "command": "dotnet",
      "args": [
        "clean",
        "--configuration",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/apps/notification-functions"
      }
    },
    {
      "label": "publish (notification-functions)",
      "command": "dotnet",
      "args": [
        "publish",
        "--configuration",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "type": "process",
      "dependsOn": "clean release (notification-functions)",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/apps/notification-functions"
      }
    },
    {
      "type": "func",
      "label": "run (notification-functions)",
      "dependsOn": "build (notification-functions)",
      "options": {
        "cwd": "${workspaceFolder}/apps/notification-functions/bin/Debug/net10.0"
      },
      "command": "host start",
      "isBackground": true,
      "problemMatcher": "$func-dotnet-watch"
    },
    {
      "label": "clean (order-processing-functions)",
      "command": "dotnet",
